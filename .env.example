# Copy to .env (git-ignored) and fill in locally. Never commit values.
# Names are provisional until core.settings lands (T005). Model IDs stay empty until the
# Meta Model API spike confirms them (T011, spec.md §8).

# Replay mode: every provider reads recorded cassettes; no keys, no network (AS-7.3, NFR-07).
REPLAY=true

# Hosted Supabase Postgres + pgvector, one schema per machine: dev_mx0, dev_mx1 or dev_mx2
# (plan.md §3). Never a local Postgres.
DATABASE_URL=
DB_SCHEMA=

# Supabase auth (JWT -> seller_id) and storage.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Internal workers send this as X-Service-Token (spec.md §2).
SERVICE_TOKEN=

# Meta Model API, OpenAI-compatible (plan.md §1).
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
MODEL_AGENT=
MODEL_STRATEGIST=
MODEL_IMAGE=
MODEL_SEGMENT=
MODEL_TRANSCRIBE=
MODEL_EMBED=

# WhatsApp Cloud API (FR-020, FR-021, FR-028).
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Muse Glimmer on Modal (brand-voice judge, PII guardian) and the Baseten open-weights fallback.
MODAL_GLIMMER_URL=
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Cost-ledger alert threshold in USD (plan.md §6).
SPEND_LIMIT_USD=100
