# Copy to .env (git-ignored) and fill in locally. Never commit values.
# Every name is a field of vitrina_core.settings.Settings (T005). Model IDs stay empty until
# they are confirmed against the Meta Model API (spec.md §8).

# Replay mode: every provider reads recorded cassettes; no keys, no network (AS-7.3, NFR-07).
REPLAY=true
# With REPLAY=false, also store each live response as a cassette under CASSETTE_DIR.
RECORD_CASSETTES=false
# CASSETTE_DIR=evals/cassettes

# Hosted Supabase Postgres + pgvector, one schema per environment (prod in production)
# (plan.md §3). Never a local Postgres. Use the session pooler or a direct connection.
# Left blank, the API starts without a database and the worker refuses to start.
DATABASE_URL=
DB_SCHEMA=

# Supabase auth (JWT -> seller_id) and storage. The service key may be a secret key (sb_secret_...)
# or the legacy service_role JWT.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Blob storage (assets, creatives, masks, exports, inbound media). local keeps files under
# STORAGE_DIR and the API serves signed links at PUBLIC_API_URL; supabase uses the private
# bucket STORAGE_BUCKET with the service-role key above.
STORAGE_BACKEND=local
# STORAGE_DIR=tmp/storage
STORAGE_BUCKET=vitrina
SIGNED_URL_TTL_S=900
PUBLIC_API_URL=http://localhost:8000
# The dashboard's public address, for share links (T083).
PUBLIC_WEB_URL=http://localhost:3000
# Browser origins that may call the API directly, comma-separated; unset behind a same-origin proxy.
# CORS_ORIGINS=https://vitrina.example

# Internal workers send this as X-Service-Token, and so does whoever creates a seller
# (POST /v1/sellers). Blank: no seller can be created and internal routes refuse everyone.
SERVICE_TOKEN=

# Shared with the dashboard's API proxy, which sends it next to the visitor's address
# (X-Vitrina-Visitor). Blank: the API never trusts that header. In production, one random
# value, also set as the dashboard Worker's secret of the same name.
VISITOR_PROXY_SECRET=

# Meta Model API, OpenAI-compatible (plan.md §1).
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
MODEL_AGENT=
MODEL_STRATEGIST=
MODEL_IMAGE=
MODEL_SEGMENT=
MODEL_TRANSCRIBE=
MODEL_EMBED=

# WhatsApp Cloud API (FR-020, FR-021, FR-028). WHATSAPP_MOCK=true serves a read-only view of
# the sends at /mock/whatsapp and keeps every send on this machine (ADR-0011).
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_MOCK=true
# MOCK_OUTBOX_PATH=tmp/mock-whatsapp.jsonl

# Muse Glimmer on Modal (brand-voice judge, PII guardian) and the Baseten open-weights fallback.
MODAL_GLIMMER_URL=
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Contacts: HMAC pepper for wa_id_hash and the key that encrypts wa_id_enc (data-model.md §5).
# The key is a Fernet key: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONTACT_HASH_PEPPER=
CONTACT_ENCRYPTION_KEY=

# The fidelity verifier compares pixels with images reduced to this long edge, so a 40 MP photo
# fits in the worker's memory. Models still get the full image.
VERIFIER_LONG_EDGE_PX=2048

# Which tasks a worker process claims, comma-separated. Leave both unset for one worker that
# claims every task and runs the sweeps (local development). WORKER_TASKS: only these, no sweeps.
# WORKER_EXCLUDE_TASKS: all but these. Both, only separators such as ",", or a name no package
# registers stops it at startup. Blank means unset.
# Production splits the tasks in two (deploy/README.md); one task is never given to two workers.
# WORKER_TASKS=conversation.process_inbound,compliance.erase_contact
# WORKER_EXCLUDE_TASKS=conversation.process_inbound,compliance.erase_contact

# Cost-ledger limit in USD (plan.md §6): every live model call recorded so far, for any seller or
# none, at the prices below (a replayed call or a model without a price counts 0). At the limit a
# warning is logged and the public tool stops, until the limit is raised; customer conversations
# and sellers' routes go on.
SPEND_LIMIT_USD=100
# Live calls are priced from Meta's list prices (packages/core/vitrina_core/pricing.py), since
# responses carry no cost. MODEL_PRICES replaces that whole table, as JSON by model ID:
# MODEL_PRICES={"muse-spark-1.3": {"input_per_mtok": 1.25, "cached_input_per_mtok": 0.15, "output_per_mtok": 4.25}}

# Daily limits on paid work; each day is a UTC day, counted in the database. 0 refuses all of it.
# These are product choices, not provider limits. Customer conversations on WhatsApp, BAJA included,
# never pass through them.
# Public showcases per day, all visitors together. An upload counts once its photo reaches the paid
# photo check, even if the photo is then refused; one job is that check, 3 scenes and 10 copies.
PUBLIC_SHOWCASE_DAILY_CAP=100
# POST /agent/turns per seller per day: enough for a day of trying the agent by hand.
SELLER_DAILY_AGENT_TURNS=200
# Creative jobs per seller per day: POST /creative/jobs, and one per directive when applying a
# brief. A job can generate many images, so this is far lower than the turns.
SELLER_DAILY_CREATIVE_JOBS=20
# Other paid jobs per seller per day: POST /briefs/generate, POST /products/import, and
# POST /replay/sessions and POST /evals/runs when they call live models.
SELLER_DAILY_PAID_JOBS=20
# Longest text POST /agent/turns takes, in characters: the same as a seller's reply to a customer.
AGENT_TURN_MAX_CHARS=4096

# Idempotency-Key: a request in progress renews its key; one not renewed for this many seconds
# lost its process (a restart), and the same request may run again.
IDEMPOTENCY_STALE_AFTER_S=90

# The event cursor stays behind events younger than this many seconds, so one whose transaction
# commits late is still read. Longer than any transaction that emits an event.
EVENT_COMMIT_GRACE_S=300
