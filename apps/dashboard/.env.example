# Copy to .env.local (never committed). Placeholders only.
# API reached through the same-origin proxy in next.config.ts; read at dev start and at build time:
API_PROXY_TARGET=http://localhost:8000
# Set only to bypass the proxy and call the API directly from the browser:
# NEXT_PUBLIC_API_BASE_URL=<https://api.example/v1>
# Supabase Auth for sellers (spec §2). Without these the dashboard runs open, for local work.
NEXT_PUBLIC_SUPABASE_URL=<https://your-project.supabase.co>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from the Supabase dashboard>
