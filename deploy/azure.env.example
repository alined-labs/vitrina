# Copy to deploy/azure.env (git-ignored) and adjust. No secrets here: they stay in .env, which
# deploy/azure.sh reads without printing a value. This file is sourced by bash.

# Azure resources, all in one resource group and one region.
AZURE_RESOURCE_GROUP=vitrina
# Assumed: the region nearest the Supabase project (Supabase → Settings → General shows it).
AZURE_LOCATION=eastus2
# Globally unique, 5 to 50 letters and digits.
AZURE_ACR=vitrinaregistry
AZURE_ENVIRONMENT=vitrina-env
API_APP=vitrina-api
WORKER_APP=vitrina-worker

# Consumption sizes. The API takes the smallest (0.25 vCPU, 0.5Gi); the worker composes and
# verifies images, so it starts one step up. Each pair must be a valid combination.
API_CPU=0.25
API_MEMORY=0.5Gi
WORKER_CPU=0.5
WORKER_MEMORY=1.0Gi

# The production schema in the Supabase database; the script migrates it before deploying.
DB_SCHEMA=prod

# What both apps run with, besides the values read from .env.
SETTINGS=(
  "REPLAY=false"
  "RECORD_CASSETTES=false"
  "WHATSAPP_MOCK=false"
  "STORAGE_BACKEND=supabase"
  "STORAGE_BUCKET=vitrina"
  "PUBLIC_WEB_URL=https://vitrina.alinedlabs.co"
  "CORS_ORIGINS=https://vitrina.alinedlabs.co"
  # The platform's ingress is the only way in, so uvicorn trusts its forwarded client address.
  "FORWARDED_ALLOW_IPS=*"
)
